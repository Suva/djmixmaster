{
  "name": "djmaster",
  "version": "0.5.0",
  "description": "Levels the loudness of DJ mixes track by track without pumping the breakdowns",
  "author": "Jaan Pullerits",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/Suva/djmixmaster",
  "repository": {
    "type": "git",
    "url": "https://github.com/Suva/djmixmaster.git"
  },
  "type": "module",
  "private": true,
  "main": "dist/main.cjs",
  "bin": {
    "djmaster": "src/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node scripts/build.mjs && electron .",
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs && electron-builder",
    "master": "node src/cli.ts",
    "test": "node scripts/build.mjs && node --test test/*.test.ts",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "ffmpeg-static": "^5.3.0",
    "typescript": "^5.8.0"
  },
  "build": {
    "appId": "com.djmixmaster.app",
    "productName": "DJ Mix Master",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": false,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "identity": "-",
      "fileAssociations": [
        {
          "ext": [
            "mp3",
            "wav",
            "flac",
            "m4a",
            "aac",
            "aif",
            "aiff",
            "ogg",
            "opus"
          ],
          "name": "Audio recording",
          "role": "Viewer",
          "rank": "Alternate"
        }
      ],
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "node_modules/ffmpeg-static/ffmpeg",
          "to": "bin/ffmpeg"
        },
        {
          "from": "node_modules/ffmpeg-static/ffmpeg.LICENSE",
          "to": "bin/ffmpeg.LICENSE"
        },
        {
          "from": "node_modules/ffmpeg-static/ffmpeg.README",
          "to": "bin/ffmpeg.README"
        }
      ]
    },
    "dmg": {
      "title": "DJ Mix Master"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "node_modules/ffmpeg-static/ffmpeg.exe",
          "to": "bin/ffmpeg.exe"
        },
        {
          "from": "node_modules/ffmpeg-static/ffmpeg.LICENSE",
          "to": "bin/ffmpeg.LICENSE"
        },
        {
          "from": "node_modules/ffmpeg-static/ffmpeg.README",
          "to": "bin/ffmpeg.README"
        }
      ]
    }
  }
}
